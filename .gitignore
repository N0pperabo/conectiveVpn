# Binaries and executables
*.exe
!bin/aether.exe
!bin/psiphon-tunnel-core.exe
!bin/sni-spoofing/sni-spoofing.exe

*.dll
!assets/wintun.dll
!bin/sni-spoofing/WinDivert64.dll
!bin/sni-spoofing/_internal/**/*.dll
!bin/sni-spoofing/_internal/**/*.pyd

# Python artifacts
**/__pycache__/**
__pycache__/
*.pyc
*.py[cod]
*$py.class

# MHR runtime configs, certificates, and adblock cache
bin/mhr/*/config.json
bin/mhr/*/ca/
bin/mhr/*/adblock_cache/
*.key
*.crt

# Databases and temporary logs
*.db
*.db-shm
*.db-wal
*.log
conective.db*
freenode.db*
testdata/
test_data/
scratch/

# WebView2 runtime cache & browser data
webview_cache/
EBWebView/

# IDE & Editor artifacts
.vscode/
.idea/
*.swp
*.swo

# Installer temporary embedded copies (created only during build)
cmd/installer/bin/
cmd/installer/*.exe
cmd/installer/*.mmdb
cmd/installer/*.dll

# Temporary files & shortcuts
*.lnk
*~
aether.toml-psiphon/
